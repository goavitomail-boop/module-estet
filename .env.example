# ─────────────────────────────────────────────────────────────
# Интеграция с ботом MAX (заявки с сайта)
# Скопируйте этот файл в .env.local и заполните значения.
# Те же переменные обязательно продублируйте в панели хостинга
# (Vercel: Settings → Environment Variables) и сделайте редеплой.
# ─────────────────────────────────────────────────────────────

# Токен бота. Получить: откройте в MAX бота @MasterBot → /mybots → ваш бот → «Токен».
# Передаётся в заголовке Authorization БЕЗ префикса Bearer (это делает код сам).
MAX_BOT_TOKEN=

# ID получателя заявок в личном диалоге с ботом.
# ВАЖНО: это НЕ номер из веб-ссылки профиля. Настоящий user_id виден только
# после того, как получатель открыл бота, нажал «Начать» и написал ему сообщение.
# Узнать его: GET /api/max-diag?key=<MAX_DIAG_KEY> — в поле incomingSenders.
# Можно указать несколько через запятую: 12345,67890
MAX_NOTIFY_USER_ID=

# Необязательно: id ГРУППОВОГО чата или канала, куда дублировать заявки.
# Для личного диалога chat_id не работает (404 chat.not.found) — оставьте пустым.
MAX_NOTIFY_CHAT_ID=

# Секрет для диагностического эндпоинта /api/max-diag. Без него эндпоинт отдаёт 404.
MAX_DIAG_KEY=

# Необязательно: базовый URL API. По умолчанию https://platform-api2.max.ru
# MAX_API_BASE=https://platform-api2.max.ru

# Необязательно: MAX_STRICT_TLS=1 включает строгую проверку TLS-сертификата.
# По умолчанию проверка отключена, т.к. API MAX использует сертификаты Минцифры РФ,
# которых обычно нет в доверенном хранилище хостинга.
# MAX_STRICT_TLS=1

# --------------------------------------------------------------------
# Админ-панель /admin
# --------------------------------------------------------------------

# Пароль входа в панель — хранится в виде scrypt-хеша, не открытым текстом.
# Формат: scrypt:<соль>:<хеш>. Сгенерировать для своего пароля:
#   node -e "const c=require('crypto');const p='ВАШ_ПАРОЛЬ';const s=c.randomBytes(16).toString('hex');console.log('scrypt:'+s+':'+c.scryptSync(p,s,64).toString('hex'))"
# Утечка переменных окружения при таком хранении не даёт войти в панель.
ADMIN_PASSWORD_HASH=

# Устаревшее: пароль открытым текстом. Работает как запасной путь, но панель
# помечает такую настройку как небезопасную. Используйте ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=

# Секрет для подписи сессионной куки. Сгенерируйте случайную строку 32+ символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если не задан, подпись завязывается на пароль — тогда смена пароля разлогинит всех.
ADMIN_SESSION_SECRET=

# Сколько замеров помещается в ОДИН слот (утро / день / вечер).
# По умолчанию 1, то есть 3 замера в день. Форма на сайте показывает
# заполненные слоты как «Занято» и не даёт на них записаться.
# Поднимайте, если на выезды ходит несколько бригад.
# MEASUREMENT_SLOT_CAPACITY=1

# Строка подключения к Postgres. Без неё заявки НЕ сохраняются,
# а список заявок и аналитика в панели недоступны.
# Vercel подставляет её сам при подключении Storage -> Neon. Код принимает любую
# из: DATABASE_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING.
DATABASE_URL=

# --------------------------------------------------------------------
# Файлы: Neon Object Storage (lib/storage.ts)
# --------------------------------------------------------------------
# Вложения к заявкам, файлы менеджеров, фото портфолио и каталога — в бакете
# files проекта Neon (объявлен в neon.ts). Ключ — на ветку production:
#   neon credentials create --scope storage:read --scope storage:write --name module-estet-site
# Секрет показывается один раз — сразу впишите сюда. Не пересылайте его в чатах.
# Пока эти переменные пустые, файлы пишутся по-старому в Vercel Blob.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Необязательно: другое имя бакета (по умолчанию files)
# STORAGE_BUCKET=files
# Необязательно: ещё адреса, с которых браузер грузит прямо в бакет, через запятую.
# Сайт и www-версия разрешены всегда.
# STORAGE_CORS_ORIGINS=

# Старое хранилище Vercel Blob. Нужно, пока не перенесены старые файлы
# (scripts/neon-storage.mjs migrate): до переноса они читаются оттуда.
# BLOB_READ_WRITE_TOKEN=
